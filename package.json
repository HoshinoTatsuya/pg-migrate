{
  "name": "@hoshinotatsuya/pg-migrate",
  "version": "0.7.2",
  "description": "Safe drizzle-orm migrations for Postgres: advisory lock with a wait ceiling, lock_timeout, refusal on INVALID indexes and skipped migrations, CREATE INDEX CONCURRENTLY, batched backfills, expand/contract phases, plans and schema drift checks.",
  "keywords": [
    "postgres",
    "postgresql",
    "drizzle",
    "drizzle-orm",
    "drizzle-kit",
    "migrations",
    "migrate",
    "advisory-lock",
    "lock-timeout",
    "concurrently",
    "schema-drift",
    "zero-downtime"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/pg-migrate.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/pg-migrate#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/pg-migrate/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "lint": "biome check src examples",
    "test": "scripts/with-postgres.sh jest-groups --out .jest-report.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@types/pg": ">=8.15.0",
    "drizzle-orm": ">=0.45.2 <0.46",
    "pg": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@hoshinotatsuya/jest-groups": "^0.7.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.15",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.2",
    "jest": "30.5.2",
    "pg": "8.18.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
